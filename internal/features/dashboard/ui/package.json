{
  "name": "dacli-dashboard-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Vue 3 SPA for the dacli dashboard — a read-only projection of GET /api/state, built to a single self-contained bundle Go embeds.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/exclude-node-modules-from-go.mjs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:evidence": "vite build --config vite.evidence.config.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.4.1",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.4.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
